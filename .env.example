# Server Port & URLs
PORT=3001
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (Read-only Gmail scope)
# Setup in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Token Encryption Secret (Must be 32 characters or will be hashed with SHA-256)
ENCRYPTION_KEY=vouch_secure_key_at_least_32_bytes_long!!

# Optional: LLM API key for dynamic friendly explanation generation
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
